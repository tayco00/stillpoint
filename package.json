{
  "name": "stillpoint-focus-workspace",
  "version": "0.1.1",
  "description": "Stillpoint",
  "private": true,
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "desktop:build": "tsc --noEmit -p tsconfig.desktop.json && vite build --config desktop.vite.config.ts",
    "desktop:package": "node scripts/generate-desktop-icon.mjs && npm run desktop:build && electron-builder --win portable --x64",
    "test": "npm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/stillpoint.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern desktop-dist --ignore-pattern desktop-release --ignore-pattern .next",
    "audit:a11y": "node scripts/run-axe.mjs",
    "audit:proxy": "node scripts/audit-proxy.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "axe-core": "^4.11.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "selenium-webdriver": "^4.35.0",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "de.stillpoint.focus",
    "productName": "Stillpoint",
    "directories": {
      "output": "desktop-release"
    },
    "files": [
      "desktop-dist/**/*",
      "desktop/main.mjs",
      "build/icon.png"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png",
      "artifactName": "Stillpoint.${ext}"
    }
  }
}
